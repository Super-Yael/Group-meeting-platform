[Unit]
Description=Back up MM Lab SQLite database
After=mm-lab.service
[Service]
Type=oneshot
User=mm-lab
Group=mm-lab
EnvironmentFile=-/etc/mm-lab-backup.env
ExecStart=/usr/bin/node /opt/mm-lab/deploy/backup.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/mm-lab
