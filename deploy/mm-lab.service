[Unit]
Description=MM Lab Hub API
After=network.target
[Service]
Type=simple
User=mm-lab
Group=mm-lab
WorkingDirectory=/opt/mm-lab/server
EnvironmentFile=/etc/mm-lab.env
ExecStart=/usr/bin/node /opt/mm-lab/server/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mm-lab
[Install]
WantedBy=multi-user.target
